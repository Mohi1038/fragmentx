{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (ASan + UBSan)",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FRAGMENTX_BUILD_TESTS": "ON",
        "FRAGMENTX_BUILD_EXAMPLES": "ON",
        "FRAGMENTX_ENABLE_ASAN": "ON",
        "FRAGMENTX_ENABLE_UBSAN": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FRAGMENTX_BUILD_EXAMPLES": "ON",
        "FRAGMENTX_INSTALL": "ON"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Release with Debug Info",
      "description": "Optimized build with debug symbols",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FRAGMENTX_BUILD_TESTS": "ON",
        "FRAGMENTX_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "description": "Debug build with ThreadSanitizer for concurrency testing",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FRAGMENTX_BUILD_TESTS": "ON",
        "FRAGMENTX_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Full CI build with tests and benchmarks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FRAGMENTX_BUILD_TESTS": "ON",
        "FRAGMENTX_BUILD_BENCHMARKS": "ON",
        "FRAGMENTX_BUILD_EXAMPLES": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",         "configurePreset": "debug" },
    { "name": "release",       "configurePreset": "release" },
    { "name": "relwithdebinfo","configurePreset": "relwithdebinfo" },
    { "name": "tsan",          "configurePreset": "tsan" },
    { "name": "ci",            "configurePreset": "ci" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4, "timeout": 300 }
    }
  ]
}

